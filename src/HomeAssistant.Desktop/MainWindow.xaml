<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HomeAssistant.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="TitleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. The drag region is a separate element so the buttons stay clickable. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DragRegion" Grid.Column="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="10">
                    <Image x:Name="TitleBarIcon" Width="16" Height="16"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="TitleBarText"
                               Text="Home Assistant"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="TitleBarCommands"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Padding="0,0,8,0">
                <!-- Hidden once Home Assistant carries a "Companion App" row of its own,
                     which happens whenever the app is signed in and the external bridge
                     attaches. It stays for a signed-out app, where no such row exists and
                     the status overlay is not showing either, so that the tray icon -
                     which may be sitting in the notification overflow - is never the only
                     way in. Decided once at startup rather than when the bridge answers,
                     so the button does not appear and then vanish. -->
                <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings" Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- The WebView2 is created in code so it can be replaced wholesale if the
                 browser process dies, and so the isolated environment is applied first. -->
            <Grid x:Name="WebViewHost" />

            <!-- Shown while connecting and whenever navigation or the browser process fails. -->
            <Grid x:Name="StatusOverlay"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Connection status"
                  AutomationProperties.LandmarkType="Main"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="460">
                    <ProgressRing x:Name="StatusProgress" IsActive="True" Width="40" Height="40"
                                  AutomationProperties.AccessibilityView="Raw"
                                  HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusTitle"
                               Text="Connecting&#x2026;"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="StatusDetail"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel x:Name="StatusActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                        <Button Content="Retry now" Click="OnRetryClick" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Settings" Click="OnSettingsClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Sits above the status overlay as well: while locked, nothing about the
                 dashboard - not even whether it connected - should be on screen. -->
            <Grid x:Name="LockOverlay"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Locked"
                  AutomationProperties.LandmarkType="Main"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
                    <FontIcon Glyph="&#xE72E;" FontSize="38" HorizontalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Locked"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="LockDetail"
                               Text="Verify with Windows Hello to show your dashboard."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="UnlockButton"
                                Content="Unlock"
                                Click="OnUnlockClick"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Exit" Click="OnLockExitClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
