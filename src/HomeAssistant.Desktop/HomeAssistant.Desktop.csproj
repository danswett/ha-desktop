<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>

    <RootNamespace>HomeAssistant.Desktop</RootNamespace>
    <AssemblyName>HomeAssistant.Desktop</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Program.cs owns Main so that single-instance redirection can run before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Plain .exe, no MSIX identity, and no machine-wide runtime prerequisites. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.6</Version>
  </PropertyGroup>

  <PropertyGroup>
    <WindowsAppSdkPackageVersion>2.5.1</WindowsAppSdkPackageVersion>
    <!--
      Set true for anything handed to another machine. A resource DLL taken from a
      different runtime version may not load, and the symptom is the silent loss of
      every toast, so a release must fail rather than ship that. Left false locally,
      where a warning is enough and a developer can see it.
    -->
    <RequireMatchingInsightsResource Condition="'$(RequireMatchingInsightsResource)' == ''">false</RequireMatchingInsightsResource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkPackageVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Renders the taskbar badge; the shell wants an HICON, which GDI+ can produce. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- DPAPI, for encrypting the refresh token and webhook id at rest. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Publishing an unpackaged WinUI app drops the project's own .pri, which is where the
    compiled XAML lives. The build produces it and `dotnet build` output works, but the
    published copy fails at startup with:
        Cannot locate resource from 'ms-appx:///MainWindow.xaml'
    Put it back into the publish set explicitly.
  -->
  <Target Name="AddProjectPriToPublish" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <_ProjectPriPath Condition="'$(ProjectPriFullPath)' != ''">$(ProjectPriFullPath)</_ProjectPriPath>
      <_ProjectPriPath Condition="'$(_ProjectPriPath)' == ''">$(OutDir)$(TargetName).pri</_ProjectPriPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_ProjectPriPath)')"
           Text="Expected the generated resource index at $(_ProjectPriPath) but it was not there. Publishing without it produces an app that cannot load its XAML." />

    <ItemGroup>
      <ResolvedFileToPublish Include="$(_ProjectPriPath)">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    Windows App SDK 2.5.1's self-contained deployment omits
    Microsoft.WindowsAppRuntime.Insights.Resource.dll, and no package in the graph
    carries it, so it cannot be referenced. Missing, it breaks exactly one thing:
    AppNotificationManager.Register() throws 0x8007007E and the app loses toasts.
    See https://github.com/microsoft/WindowsAppSDK/issues/6774 and
    tools/Copy-InsightsResource.ps1. Run for build output and publish output alike, so
    that running from the IDE behaves the same as the installed app.
  -->
  <PropertyGroup>
    <_InsightsStrictSwitch Condition="'$(RequireMatchingInsightsResource)' == 'true'">-RequireVersionMatch</_InsightsStrictSwitch>
  </PropertyGroup>

  <Target Name="CopyInsightsResourceToOutput" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Copy-InsightsResource.ps1&quot; -TargetDirectory &quot;$(OutDir.TrimEnd('\'))&quot; -Version &quot;$(WindowsAppSdkPackageVersion)&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; $(_InsightsStrictSwitch)"
          ContinueOnError="$(RequireMatchingInsightsResource.Equals('false'))" />
  </Target>

  <Target Name="CopyInsightsResourceToPublish" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Copy-InsightsResource.ps1&quot; -TargetDirectory &quot;$(PublishDir.TrimEnd('\'))&quot; -Version &quot;$(WindowsAppSdkPackageVersion)&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; $(_InsightsStrictSwitch)"
          ContinueOnError="$(RequireMatchingInsightsResource.Equals('false'))" />
  </Target>

</Project>



