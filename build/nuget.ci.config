<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for continuous integration.

  The repo-root nuget.config pins restores to the Microsoft package proxy, because
  api.nuget.org is blocked by Defender network protection on the machines this is
  developed on. A hosted CI runner is the opposite case: it reaches nuget.org fine and
  cannot reach the Microsoft proxy at all.

  Rather than weaken the local config, CI passes this one explicitly by path.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
