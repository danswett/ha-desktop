<?xml version="1.0" encoding="utf-8"?>
<!--
  api.nuget.org is blocked by Defender network protection on these machines, and the
  user-level NuGet.Config also lists an authenticated ADO feed that fails restore with
  401 in a non-interactive build. Pin this repo to the Microsoft package proxy only.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
  </auditSources>
</configuration>
